{
	"name": "macos-portfolio-server",
	"version": "0.1.0",
	"description": "Backend API + admin for Mustafa Kırpık portfolio",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "tsx watch --env-file=.env src/index.ts",
		"start": "node --env-file=.env --import tsx/esm src/index.ts",
		"build": "tsc -p tsconfig.json",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx --env-file=.env src/db/migrate.ts",
		"db:seed": "tsx --env-file=.env src/db/seed.ts",
		"db:import-github": "tsx --env-file=.env src/db/import-github-projects.ts",
		"db:import-cv": "tsx --env-file=.env src/db/import-cv.ts",
		"db:studio": "drizzle-kit studio",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@hono/node-server": "^1.13.7",
		"@hono/node-ws": "^1.3.1",
		"drizzle-orm": "^0.36.4",
		"hono": "^4.6.10",
		"mysql2": "^3.11.4",
		"nanoid": "^5.1.11",
		"nodemailer": "^8.0.7",
		"sharp": "^0.34.5",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@types/node": "^22.9.0",
		"@types/nodemailer": "^8.0.0",
		"dotenv": "^16.4.5",
		"drizzle-kit": "^0.28.1",
		"tsx": "^4.19.2",
		"typescript": "^5.6.3",
		"vite": "^5.4.21",
		"vitest": "^2.1.9"
	}
}
