# Production .env — sunucuda /var/www/portfolio/server/.env olarak kopyala ve doldur.
# NOT: Bu dosya bir ÖRNEK. Gerçek secret'ları git'e KOYMA.

# Server
PORT=3000
NODE_ENV=production
PUBLIC_BASE_URL=https://portfolio.xn--mustafakrpk-6zbc.com

# Database — sunucudaki production MySQL kullanıcısı (dev şifresini KULLANMA)
DATABASE_URL=mysql://portfolio_user:GUCLU_BIR_SIFRE@localhost:3306/portfolio_db

# Auth
SESSION_COOKIE_NAME=mk_portfolio_session
SESSION_LIFETIME_DAYS=30
ADMIN_GITHUB_USERNAME=mustafakrpk

# GitHub OAuth — production OAuth App (callback URL aşağıdakiyle birebir eşleşmeli)
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=https://portfolio.xn--mustafakrpk-6zbc.com/api/auth/github/callback

# Uploads
UPLOAD_DIR=/var/www/portfolio/uploads
UPLOAD_PUBLIC_URL=/uploads
MAX_UPLOAD_MB=5

# E-posta bildirimi (opsiyonel) — Gmail App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=muskirp42@gmail.com
SMTP_PASS=
SMTP_FROM="Mustafa Kırpık Portfolyo <muskirp42@gmail.com>"
NOTIFY_EMAIL=muskirp42@gmail.com
